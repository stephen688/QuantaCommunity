flowchart TD
    A["deleteContent(contentId)"] --> B["校验：内容存在 + 当前用户是作者"]
    B --> C["同一事务（事实源 + 事件）"]
    C --> C1["软删 tb_content，删图片行"]
    C --> C2["删互动明细、评论、子回答"]
    C --> C3["登记 Feed 删除事件 + ES 对账事件"]
    C --> D["afterCommit（投影清理）"]
    D --> D1["失效详情缓存 + 热榜缓存"]
    D --> D2["6 个推荐 ZSET 移除成员"]
    D --> D3["删点赞/收藏集合、删向量索引"]
