# ========================================
# 本地开发私有配置模板（可提交 Git）
# 用法：复制为 application-local-secret.yml 并填入真实密钥
# ========================================

spring:
  datasource:
    password: your-mysql-password
  rabbitmq:
    password: your-rabbitmq-password
  ai:
    openai:
      api-key: sk-your-deepseek-key
    qwen-openai:
      api-key: sk-your-qwen-key

quanta:
  jwt:
    user-secret-key: your-very-long-secret-key-for-jwt-token-generation-1234567890
  alioss:
    access-key-id: your-aliyun-access-key-id
    access-key-secret: your-aliyun-access-key-secret
  # 内容安全（可与 OSS 同一 RAM 用户，须单独开通 Green 权限）
  moderation:
    access-key-id: your-aliyun-access-key-id
    access-key-secret: your-aliyun-access-key-secret
  wechat:
    secret: your-wechat-mini-program-secret
