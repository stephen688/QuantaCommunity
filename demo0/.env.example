# demo0 本地/服务器环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
#
# 若使用 application-local-secret.yml（spring.profiles.include=local-secret），
# 下列 quanta.* 项可在 yml 中配置，不必重复设置环境变量。

# --- 数据库 ---
DB_PASSWORD=your-mysql-password

# --- RabbitMQ ---
RABBITMQ_PASSWORD=your-rabbitmq-password

# --- JWT ---
JWT_USER_SECRET_KEY=your-jwt-secret

# --- 阿里云 OSS ---
ALIOSS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIOSS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# --- 阿里云内容安全（AI 云审核，可与 OSS 同账号）---
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# --- 微信小游戏/小程序 ---
WECHAT_SECRET=your-wechat-secret

# --- LLM（可选）---
OPENAI_API_KEY=sk-your-deepseek-key
QWEN_API_KEY=sk-your-qwen-key

# --- Spring Profile（服务器部署时去掉 local-secret）---
# SPRING_PROFILES_INCLUDE=
