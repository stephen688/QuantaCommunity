# Phase 3：管理端审核 + 审核态业务校验
#
# 前置：
#   1. 01-auth-user.http（userToken、adminToken）
#   2. 02-upload-publish.http（contentIdProf、contentIdLife）
#
# 变量：contentIdProf / contentIdLife / questionId 来自 Phase 2 响应脚本或 env.sh
#
# 注意：ContentServiceImpl.publish 当前 TODO 默认 auditStatus=已通过(L154)；
#   P3-04「未审核不可答」若返回 200，请 UPDATE content SET audit_status=0 后重试，
#   或在 RESULTS 记为与实现不一致的缺陷。

@baseUrl = {{baseUrl}}
@userToken = {{userToken}}
@adminToken = {{adminToken}}
@contentIdProf = {{contentIdProf}}
@contentIdLife = {{contentIdLife}}
@questionId = {{questionId}}

###############################################################################
# Phase 3 — 管理端内容审核
###############################################################################

### P3-01 待审列表 auditStatus=0 → body.code=200
GET {{baseUrl}}/admin/content/page?pageNum=1&pageSize=10&auditStatus=0
authorization: {{adminToken}}

> {%
  client.test("P3-01 pending page", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    client.assert(response.body.data != null);
  });
%}

### P3-02 普通用户访问待审列表 → HTTP 403
GET {{baseUrl}}/admin/content/page?pageNum=1&pageSize=10&auditStatus=0
authorization: {{userToken}}

> {%
  client.test("P3-02 user forbidden", function () {
    client.assert(response.status === 403);
  });
%}

### P3-03 未审核帖尝试回答（设计预期 body.code=400）
# 依赖 contentIdProf；若发布时已默认通过审核，本用例用于暴露实现差异
POST {{baseUrl}}/answer/publish
authorization: {{userToken}}
Content-Type: application/json

{
  "questionId": {{contentIdProf}},
  "content": "审核前应失败"
}

> {%
  client.test("P3-03 answer before audit (design)", function () {
    client.assert(response.status === 200);
    // 设计：auditStatus!=1 → 400；若实现默认通过则可能为 200
    if (response.body.code === 400) {
      client.assert(response.body.msg && response.body.msg.indexOf("审核") >= 0);
    } else {
      client.log("WARN: 发布默认已通过审核，与设计不符，见 ContentServiceImpl L154");
    }
  });
%}

### P3-04 通过专业帖 auditResult=1
# @name auditApproveProf
POST {{baseUrl}}/admin/content/audit
authorization: {{adminToken}}
Content-Type: application/json

{
  "contentId": {{contentIdProf}},
  "auditResult": 1
}

> {%
  client.test("P3-04 approve professional", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
  });
%}

### P3-05 驳回生活帖 auditResult=2 + rejectReason
# @name auditRejectLife
POST {{baseUrl}}/admin/content/audit
authorization: {{adminToken}}
Content-Type: application/json

{
  "contentId": {{contentIdLife}},
  "auditResult": 2,
  "rejectReason": "API测试驳回-生活帖"
}

> {%
  client.test("P3-05 reject life", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
  });
%}

### P3-06 专业帖审核通过后回答 → body.code=200
POST {{baseUrl}}/answer/publish
authorization: {{userToken}}
Content-Type: application/json

{
  "questionId": {{questionId}},
  "content": "专业区审核通过后的测试回答"
}

> {%
  client.test("P3-06 answer after approve", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    client.assert(response.body.data && response.body.data.answerId);
  });
  if (response.body.code === 200 && response.body.data && response.body.data.answerId) {
    var id = String(response.body.data.answerId);
    client.global.set("answerId", id);
    client.global.set("ANSWER_ID", id);
  }
%}

### P3-07 生活帖回答 → body.code=400「仅专业区」
POST {{baseUrl}}/answer/publish
authorization: {{userToken}}
Content-Type: application/json

{
  "questionId": {{contentIdLife}},
  "content": "生活区不可回答"
}

> {%
  client.test("P3-07 answer on life content", function () {
    client.assert(response.body.code === 400);
    client.assert(response.body.msg && response.body.msg.indexOf("专业") >= 0);
  });
%}

### P3-08 驳回帖回答 → body.code=400「未通过审核」
POST {{baseUrl}}/answer/publish
authorization: {{userToken}}
Content-Type: application/json

{
  "questionId": {{contentIdLife}},
  "content": "已驳回生活帖不可答"
}

> {%
  client.test("P3-08 answer on rejected", function () {
    client.assert(response.body.code === 400);
  });
%}

### P3-09 无 adminToken 审核 → HTTP 401 或 403
POST {{baseUrl}}/admin/content/audit
authorization: {{userToken}}
Content-Type: application/json

{
  "contentId": {{contentIdProf}},
  "auditResult": 1
}

> {%
  client.test("P3-09 non-admin audit", function () {
    client.assert(response.status === 403 || response.status === 401);
  });
%}
