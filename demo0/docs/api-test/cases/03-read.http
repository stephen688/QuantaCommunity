# Phase 4：读接口 — search、rag、answer、comment、follow、notification + 内容读
#
# 前置：
#   1. 01-auth-user.http（userToken、userId）
#   2. 02-upload-publish.http + 02-admin-audit.http（contentIdProf 已审核、answerId）
#
# 变量：http-client.env.json → dev，或 Phase 0–3 响应脚本写入的 client.global
# ES：/search/content、/rag/search 未配置 ES 时可能 BLOCKED（记 RESULTS，不计 FAIL）
#
# contentType：1=生活求助，2=专业问答
#
# scene 语义（推荐流个性化 D8，2026-09-24 契约同步）：
#   latest / recommend / 缺省 → 画像流（登录用户画像重排；匿名=α=1 纯热度兜底；
#     游标入参 lastScore/offset 忽略，出参固定 minScore=null、offset=0，曝光 set 为隐式游标）
#   hot → 既有 ZSET 热度序（曝光去重已取消，连续拉取结果可重复）
#   非法 scene → 业务异常 body.code=400（"场景参数异常"，语义不变）

@baseUrl = {{baseUrl}}
@userToken = {{userToken}}
@userId = {{userId}}
@contentIdProf = {{contentIdProf}}
@questionId = {{questionId}}
@answerId = {{answerId}}

###############################################################################
# Content — 推荐 / 详情（Phase 4 读）
###############################################################################

### P4-01 推荐流 scene=latest（画像流语义，D8）→ body.code=200
# 登录新用户（无画像）= 热度兜底序；出参游标固定 minScore=null、offset=0
GET {{baseUrl}}/content/recommend?scene=latest&pageSize=5&offset=0
authorization: {{userToken}}

> {%
  client.test("P4-01 recommend latest profile flow", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data != null);
    // D8 契约：画像流出参游标固定，minScore 恒为 null、offset 恒为 0
    client.assert(data.minScore === null);
    client.assert(data.offset === 0);
    client.assert(typeof data.hasMore === "boolean");
    client.assert(Array.isArray(data.list));
    // list 装配完整：每条记录必须携带 contentId
    data.list.forEach(function (item) {
      client.assert(item != null && item.contentId != null);
    });
  });
%}

### P4-01a scene=latest 游标入参忽略 → body.code=200 且出参仍 minScore=null、offset=0
# 画像流以曝光 set 为隐式游标（D8）：显式传 lastScore/offset 不影响出参游标
GET {{baseUrl}}/content/recommend?scene=latest&pageSize=5&lastScore=123456.0&offset=99
authorization: {{userToken}}

> {%
  client.test("P4-01a latest ignores cursor params", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data != null);
    client.assert(data.minScore === null);
    client.assert(data.offset === 0);
    client.assert(Array.isArray(data.list));
  });
%}

### P4-01b scene=recommend 登录用户（画像流）→ body.code=200
# 与 latest 同路径：出参契约一致，list 装配完整
GET {{baseUrl}}/content/recommend?scene=recommend&pageSize=5&offset=0
authorization: {{userToken}}

> {%
  client.test("P4-01b recommend explicit profile flow", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data != null);
    client.assert(data.minScore === null);
    client.assert(data.offset === 0);
    client.assert(typeof data.hasMore === "boolean");
    client.assert(Array.isArray(data.list));
    data.list.forEach(function (item) {
      client.assert(item != null && item.contentId != null);
    });
  });
%}

### P4-01c scene=hot 热度序（第一次拉取，D8）→ body.code=200
# hot 流已取消曝光去重：拉取不写曝光 set；记录首页 contentId 序列供 P4-01d/P4-01e 对比
GET {{baseUrl}}/content/recommend?scene=hot&pageSize=5&offset=0
authorization: {{userToken}}

> {%
  client.test("P4-01c hot first fetch", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data != null);
    client.assert(Array.isArray(data.list));
    data.list.forEach(function (item) {
      client.assert(item != null && item.contentId != null);
    });
    var ids = data.list.map(function (item) { return String(item.contentId); });
    client.global.set("hotFirstPageIds", ids.join(","));
  });
%}

### P4-01d scene=hot 连续第二次同参数拉取 → 结果可重复（D8：无曝光过滤/降级重拉）
# 行为差异断言：改造前 hot 首拉写曝光、次拉滤光；改造后 hot 零曝光读写，两次结果一致
GET {{baseUrl}}/content/recommend?scene=hot&pageSize=5&offset=0
authorization: {{userToken}}

> {%
  client.test("P4-01d hot second fetch repeatable", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data != null);
    client.assert(Array.isArray(data.list));
    var ids = data.list.map(function (item) { return String(item.contentId); });
    var firstIds = String(client.global.get("hotFirstPageIds") || "");
    // 两次同参数拉取必须完全可重复（不再因曝光被滤掉）
    client.assert(ids.join(",") === firstIds);
  });
%}

### P4-01e scene=recommend 匿名访问 → 热度兜底序与 hot 一致（D8：α=1）
# 匿名无画像、不读写曝光：min-max 归一化是单调变换，排序与 hot 热度序一致
GET {{baseUrl}}/content/recommend?scene=recommend&pageSize=5&offset=0

> {%
  client.test("P4-01e recommend anonymous matches hot order", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data != null);
    client.assert(data.minScore === null);
    client.assert(data.offset === 0);
    client.assert(Array.isArray(data.list));
    var ids = data.list.map(function (item) { return String(item.contentId); });
    var hotIds = String(client.global.get("hotFirstPageIds") || "");
    client.log("recommend(anon)=" + ids.join(",") + " hot=" + hotIds);
    // 匿名画像流 = 纯热度兜底，首页序列与 hot 一致
    client.assert(ids.join(",") === hotIds);
  });
%}

### P4-01f 非法 scene → body.code=400（语义不变）
GET {{baseUrl}}/content/recommend?scene=bogus&pageSize=5&offset=0
authorization: {{userToken}}

> {%
  client.test("P4-01f invalid scene rejected", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 400);
    client.assert(response.body.msg === "场景参数异常");
  });
%}

### P4-02 内容详情（已审核专业帖）→ body.code=200
GET {{baseUrl}}/content/detail/{{contentIdProf}}
authorization: {{userToken}}

> {%
  client.test("P4-02 content detail", function () {
    client.assert(response.body.code === 200);
    client.assert(response.body.data && response.body.data.contentId);
  });
%}

### P4-03 不存在的内容 → body.code=404 或 400
GET {{baseUrl}}/content/detail/999999
authorization: {{userToken}}

> {%
  client.test("P4-03 content not found", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 404 || response.body.code === 400);
  });
%}

### P4-04 用户主页 → body.code=200
GET {{baseUrl}}/user/{{userId}}/profile
authorization: {{userToken}}

> {%
  client.test("P4-04 user profile", function () {
    client.assert(response.body.code === 200);
    client.assert(response.body.data);
  });
%}

###############################################################################
# Search — 5 个读相关接口
###############################################################################

### P4-05 搜索内容（keyword + contentType=2）→ body.code=200
# 依赖 ES；失败可标 BLOCKED
GET {{baseUrl}}/search/content?keyword=API测试&contentType=2&current=1&pageSize=10&sortType=new
authorization: {{userToken}}

> {%
  client.test("P4-05 search content", function () {
    client.assert(response.status === 200);
    if (response.body.code === 200) {
      client.assert(response.body.data != null);
    } else {
      client.log("ES 未就绪时可标 BLOCKED: " + (response.body.msg || ""));
    }
  });
%}

### P4-06 空关键词 → body.code=400
GET {{baseUrl}}/search/content?keyword=&current=1&pageSize=10
authorization: {{userToken}}

> {%
  client.test("P4-06 empty keyword", function () {
    client.assert(response.body.code === 400);
  });
%}

### P4-07 搜索历史关键词 → body.code=200
GET {{baseUrl}}/search/history/keywords
authorization: {{userToken}}

> {%
  client.test("P4-07 search history keywords", function () {
    client.assert(response.body.code === 200);
    client.assert(Array.isArray(response.body.data));
  });
%}

### P4-08 热门发现 → body.code=200
GET {{baseUrl}}/search/trending
authorization: {{userToken}}

> {%
  client.test("P4-08 trending", function () {
    client.assert(response.body.code === 200);
    client.assert(response.body.data != null);
  });
%}

### P4-09 无 Token 搜索 → HTTP 401
GET {{baseUrl}}/search/content?keyword=test&current=1&pageSize=10

> {%
  client.test("P4-09 search without token", function () {
    client.assert(response.status === 401);
  });
%}

###############################################################################
# RAG — enableAi=false（不依赖 DeepSeek）
###############################################################################

### P4-10 RAG 检索（enableAi=false）→ body.code=200 或 ES 阻塞
POST {{baseUrl}}/rag/search
authorization: {{userToken}}
Content-Type: application/json

{
  "query": "专业问答 API测试",
  "contentType": 2,
  "enableAi": false
}

> {%
  client.test("P4-10 rag without ai", function () {
    client.assert(response.status === 200);
    if (response.body.code === 200) {
      client.assert(response.body.data != null);
    } else {
      client.log("RAG/ES 未配置时可标 BLOCKED");
    }
  });
%}

### P4-11 RAG 空 query → body.code=400（@Valid）
POST {{baseUrl}}/rag/search
authorization: {{userToken}}
Content-Type: application/json

{
  "query": "",
  "enableAi": false
}

> {%
  client.test("P4-11 rag empty query", function () {
    client.assert(response.body.code === 400);
  });
%}

### P4-12 RAG enableAi=true（环境依赖，失败记 BLOCKED）
POST {{baseUrl}}/rag/search
authorization: {{userToken}}
Content-Type: application/json

{
  "query": "校友互助",
  "enableAi": true
}

> {%
  client.test("P4-12 rag with ai (env)", function () {
    if (response.body.code !== 200) {
      client.log("DeepSeek/通义未配置时标 BLOCKED，非 FAIL");
    }
  });
%}

