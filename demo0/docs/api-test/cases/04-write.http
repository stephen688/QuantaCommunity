###############################################################################
# Notification — 已读
###############################################################################

### P5-21 标记单条已读（依赖 notificationId）
PUT {{baseUrl}}/notification/read/{{notificationId}}
authorization: {{userToken}}

> {%
  client.test("P5-21 mark notification read", function () {
    if (!"{{notificationId}}") {
      client.log("无通知时先执行点赞/评论/关注以产生通知，或跳过");
      return;
    }
    client.assert(response.body.code === 200);
  });
%}

### P5-22 全部已读 → body.code=200
PUT {{baseUrl}}/notification/readAll
authorization: {{userToken}}

> {%
  client.test("P5-22 mark all read", function () {
    client.assert(response.body.code === 200);
  });
%}

### P5-23 不存在通知已读 → body.code=404 或 400
PUT {{baseUrl}}/notification/read/999999
authorization: {{userToken}}

> {%
  client.test("P5-23 read missing notification", function () {
    client.assert(response.body.code === 404 || response.body.code === 400);
  });
%}
