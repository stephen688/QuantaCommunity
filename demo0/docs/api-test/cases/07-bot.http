    client.assert(response.status === 403);
    client.assert(response.body.code === 403);
  });
%}

###############################################################################
# B2 — 单条真实 E2E（提交后手动等待异步链路，再执行 B2-02~B2-04）
###############################################################################

### B2-01 @框框 + mentionBot=true → 写回 botTriggerCommentId
# @name botTriggerComment
POST {{baseUrl}}/comment/send
authorization: {{userToken}}
Content-Type: application/json

{
  "contentId": {{botTestContentId}},
  "parentId": null,
  "content": "@框框 E2E-{{$timestamp}} 请简短回复并说明你是 AI",
  "mentionBot": true
}

> {%
  client.test("B2-01 submit bot mention", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    client.assert(response.body.data != null, "missing trigger comment id");
  });
  if (response.body.code === 200 && response.body.data != null) {
    var triggerId = String(response.body.data);
    client.global.set("botTriggerCommentId", triggerId);
    client.global.set("BOT_TRIGGER_COMMENT_ID", triggerId);
  }
%}

# 手动等待：确认触发评论 audit_status 0→1、Outbox BOT_MENTION_REQUESTED=SENT、
# QuantaBot 有完整 Langfuse run 且生成文本以 [框框·AI 学长] 开头，再继续下面三条。

### B2-02 bot token 读取 chain → 触发评论已可见
GET {{baseUrl}}/bot/comment/chain?commentId={{botTriggerCommentId}}
Authorization: Bearer {{botToken}}

> {%
  client.test("B2-02 trigger comment visible to bot", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var chain = response.body.data && response.body.data.chain || [];
    var triggerId = client.global.get("botTriggerCommentId") || "{{botTriggerCommentId}}";
    client.assert(chain.some(function (node) {
      return String(node.commentId) === String(triggerId);
    }), "trigger comment is not in chain");
  });
%}

### B2-03 普通用户查回复 → 找到框框 AI 回复并写回 botReplyCommentId
GET {{baseUrl}}/comment/replyList?parentCommentId={{botTriggerCommentId}}&contentId={{botTestContentId}}&pageNum=1&pageSize=50&sortType=1
authorization: {{userToken}}

> {%
  client.test("B2-03 visible bot reply", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var records = response.body.data && response.body.data.list || [];
    var botReplies = records.filter(function (row) {
      return String(row.userId) === String("{{botUserId}}")
        && row.isBot === true
        && row.nickName === "框框"
        && typeof row.content === "string"
        && row.content.indexOf("[框框·AI 学长]") === 0;
    });
    client.assert(botReplies.length === 1, "expected exactly one visible bot reply");
    client.assert(botReplies[0].commentId != null);
    client.global.set("botReplyCommentId", String(botReplies[0].commentId));
    client.global.set("BOT_REPLY_COMMENT_ID", String(botReplies[0].commentId));
  });
%}

### B2-04 重复查询 → 同一 trigger 只有一条 bot 回复
GET {{baseUrl}}/comment/replyList?parentCommentId={{botTriggerCommentId}}&contentId={{botTestContentId}}&pageNum=1&pageSize=50&sortType=1
authorization: {{userToken}}

> {%
  client.test("B2-04 bot reply idempotency", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var records = response.body.data && response.body.data.list || [];
    var botReplies = records.filter(function (row) {
      return String(row.userId) === String("{{botUserId}}") && row.isBot === true;
    });
    client.assert(botReplies.length === 1, "duplicate bot replies detected");
  });
%}

