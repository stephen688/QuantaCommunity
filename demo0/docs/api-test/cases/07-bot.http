###############################################################################
# B1 — D5/D6 只读、同步与 policy tombstone
###############################################################################

### B1-01 chain → post 摘要 + 直接回复链字段完整
GET {{baseUrl}}/bot/comment/chain?commentId={{botTriggerCommentId}}
Authorization: Bearer {{botToken}}

> {%
  client.test("B1-01 chain contract", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data && data.post, "missing post summary");
    client.assert(data.post.postId != null);
    client.assert(data.post.userId != null);
    client.assert(typeof data.post.title === "string");
    client.assert(typeof data.post.content === "string");
    client.assert(Array.isArray(data.chain), "chain must be an array");
    client.assert(data.chain.length > 0, "chain must include the trigger comment");
    data.chain.forEach(function (node) {
      client.assert(node.commentId != null);
      client.assert(node.userId != null);
      client.assert(typeof node.content === "string");
      client.assert(Object.prototype.hasOwnProperty.call(node, "parentId"));
      client.assert(Object.prototype.hasOwnProperty.call(node, "replyCommentId"));
      client.assert(typeof node.createTime === "string");
    });
  });
%}

### B1-02 tree → 稳定分页与升序楼层
GET {{baseUrl}}/bot/comment/tree?postId={{botTestContentId}}&pageNum=1&pageSize=50&sortType=asc
Authorization: Bearer {{botToken}}

> {%
  client.test("B1-02 tree contract", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data && typeof data.total === "number");
    client.assert(Array.isArray(data.list));
    client.assert(data.total >= data.list.length);
    for (var i = 0; i < data.list.length; i += 1) {
      client.assert(data.list[i].commentId != null);
      client.assert(data.list[i].userId != null);
      if (i > 0) {
        client.assert(data.list[i - 1].commentId <= data.list[i].commentId,
          "sortType=asc must keep stable comment order");
      }
    }
  });
%}

### B1-03 history → 只返回 bot user_id=10000 的本帖历史
GET {{baseUrl}}/bot/comment/history?userId={{botUserId}}&postId={{botTestContentId}}&pageNum=1&pageSize=50
Authorization: Bearer {{botToken}}

> {%
  client.test("B1-03 bot history contract", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data && Array.isArray(data.list));
    data.list.forEach(function (node) {
      client.assert(String(node.userId) === String("{{botUserId}}"));
      client.assert(node.commentId != null);
      client.assert(typeof node.content === "string");
    });
  });
%}

### B1-04 content sync → docId/docKind/status/updatedAt 形状
GET {{baseUrl}}/bot/content/sync?since=1970-01-01&pageNum=1&pageSize=50
Authorization: Bearer {{botToken}}

> {%
  client.test("B1-04 content sync contract", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data && Array.isArray(data.items));
    client.assert(typeof data.hasMore === "boolean");
    data.items.forEach(function (doc) {
      client.assert(typeof doc.docId === "string" && doc.docId.length > 0);
      client.assert(typeof doc.docKind === "string" && doc.docKind.length > 0);
      client.assert(typeof doc.status === "string");
      client.assert(typeof doc.updatedAt === "string");
    });
  });
%}

### B1-05 policy upsert → admin only；写入套件隔离 docId 并记录变量
# @name botPolicyUpsert
POST {{baseUrl}}/bot/knowledge/policy-docs
authorization: {{adminToken}}
Content-Type: application/json

{
  "docId": "bot-http-policy-task14",
  "title": "Bot HTTP acceptance policy",
  "content": "Temporary local acceptance fixture. Do not use as production policy."
}

> {%
  client.test("B1-05 policy upsert", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
  });
  var policyDocId = "bot-http-policy-task14";
  client.global.set("botPolicyDocId", policyDocId);
  client.global.set("BOT_POLICY_DOC_ID", policyDocId);
  // 以本地时钟回拨 120 秒作为本轮同步水位线，覆盖本请求和随后软删的秒级时间戳。
  var clock = new Date(Date.now() - 120 * 1000);
  function pad(value) {
    return String(value).padStart(2, "0");
  }
  var syncSince = clock.getFullYear() + "-"
    + pad(clock.getMonth() + 1) + "-"
    + pad(clock.getDate()) + " "
    + pad(clock.getHours()) + ":"
    + pad(clock.getMinutes()) + ":"
    + pad(clock.getSeconds());
  client.global.set("botPolicySyncSince", syncSince);
  client.global.set("botPolicySyncSinceEncoded", encodeURIComponent(syncSince));
%}

### B1-06 policy delete → 软删为 tombstone
DELETE {{baseUrl}}/bot/knowledge/policy-docs/{{botPolicyDocId}}
authorization: {{adminToken}}

> {%
  client.test("B1-06 policy tombstone write", function () {
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
  });
%}

### B1-06b sync → 能看到相同 docId 的 status=deleted
# 使用 B1-05 生成并 URL 编码的本轮水位线；不扫描历史全量数据。
# pageSize=200 是服务端上限，并强制确认该水位线窗口没有下一页。
GET {{baseUrl}}/bot/content/sync?since={{botPolicySyncSinceEncoded}}&pageNum=1&pageSize=200
Authorization: Bearer {{botToken}}

> {%
  client.test("B1-06b policy tombstone visible", function () {
    var syncSince = client.global.get("botPolicySyncSince");
    var syncSinceEncoded = client.global.get("botPolicySyncSinceEncoded");
    client.assert(/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(syncSince || ""),
      "missing botPolicySyncSince; run B1-05 first");
    client.assert(syncSinceEncoded && syncSinceEncoded.indexOf("%20") >= 0,
      "missing URL-encoded botPolicySyncSince; run B1-05 first");
    client.assert(response.status === 200);
    client.assert(response.body.code === 200);
    var data = response.body.data;
    client.assert(data && data.hasMore === false,
      "sync hasMore=true; first page is incomplete, paginate before concluding");
    var docId = client.global.get("botPolicyDocId") || "{{botPolicyDocId}}";
    client.assert(docId && docId.indexOf("botPolicyDocId") < 0, "missing policy doc id");
    var items = data.items || [];
    var tombstone = items.some(function (doc) {
      return doc.docId === docId && doc.status === "deleted";
    });
    client.assert(tombstone, "deleted policy doc tombstone not found in sync");
  });
%}

### B1-07 普通用户写 policy doc → HTTP 403 + body.code=403
POST {{baseUrl}}/bot/knowledge/policy-docs
authorization: {{userToken}}
Content-Type: application/json

{
  "docId": "bot-http-user-forbidden-{{$timestamp}}",
  "title": "Should not be accepted",
  "content": "普通用户不能写 policy doc"
}

> {%
