# Admin Comment — 分页 / 举报 / 处理
###############################################################################

### P6-11 评论分页（按帖子）→ body.code=200
GET {{baseUrl}}/admin/comment/page?pageNum=1&pageSize=10&contentId={{contentIdProf}}
authorization: {{adminToken}}

> {%
  client.test("P6-11 admin comment page", function () {
    client.assert(response.body.code === 200);
  });
%}

### P6-12 评论举报分页
GET {{baseUrl}}/admin/comment/report/page?pageNum=1&pageSize=10&status=0
authorization: {{adminToken}}

> {%
  client.test("P6-12 comment report page", function () {
    client.assert(response.body.code === 200);
  });
%}

### P6-13 处理评论举报（驳回 handleResult=4）
POST {{baseUrl}}/admin/comment/report/handle
authorization: {{adminToken}}
Content-Type: application/json

{
  "reportId": 1,
  "handleResult": 4,
  "handleRemark": "API测试-无记录时可 404"
}

> {%
  client.test("P6-13 handle comment report", function () {
    client.assert(response.body.code === 200 || response.body.code === 404 || response.body.code === 400);
  });
%}

###############################################################################
# Admin Answer — 分页 / 审核
###############################################################################

### P6-14 回答分页 → body.code=200
GET {{baseUrl}}/admin/answer/page?pageNum=1&pageSize=10&contentId={{contentIdProf}}
authorization: {{adminToken}}

> {%
  client.test("P6-14 admin answer page", function () {
    client.assert(response.body.code === 200);
  });
%}

### P6-15 审核回答通过（contentId 字段存 answerId）
POST {{baseUrl}}/admin/answer/audit
authorization: {{adminToken}}
Content-Type: application/json

{
  "contentId": {{answerId}},
  "auditResult": 1
}

> {%
  client.test("P6-15 audit answer approve", function () {
    client.assert(response.body.code === 200);
  });
%}

###############################################################################
# IdentityExam — 实名认证
###############################################################################

### P6-16 实名认证分页 → body.code=200
GET {{baseUrl}}/admin/identityExam/page?pageNum=1&pageSize=10
authorization: {{adminToken}}

> {%
  client.test("P6-16 identity exam page", function () {
    client.assert(response.body.code === 200);
  });
  if (response.body.code === 200 && response.body.data && response.body.data.records
      && response.body.data.records.length > 0) {
    client.global.set("authId", String(response.body.data.records[0].id));
  }
%}

### P6-17 实名详情（需 authId）
GET {{baseUrl}}/admin/identityExam/userAuth/detail/{{authId}}
authorization: {{adminToken}}

> {%
  client.test("P6-17 identity detail", function () {
    if (!client.global.get("authId")) {
      client.log("无待审实名记录时标 BLOCKED");
      return;
    }
    client.assert(response.body.code === 200);
  });
%}

### P6-18 实名审核（示例：无 authId 时跳过）
POST {{baseUrl}}/admin/identityExam/audit
authorization: {{adminToken}}
Content-Type: application/json

{
  "authId": 1,
  "auditResult": 2,
  "auditRemark": "API测试驳回示例"
}

> {%
  client.test("P6-18 identity audit", function () {
    client.assert(response.body.code === 200 || response.body.code === 404 || response.body.code === 400);
  });
%}
