# QuantaBot 环境配置模板——复制为 .env 使用（cp .env.example .env）
# 纪律：密钥只进 .env（不入库）；字段与 infra/settings.py 的 Settings 一一对应
# 不需要覆盖的行请整行删除（缺失该行 = 使用代码默认值；值留空会触发解析失败而非回退默认）

# 运行环境：dev | prod
QUANTABOT_APP_ENV=dev

# 服务监听地址与端口（Agent 自有配置，默认 8000）
QUANTABOT_HOST=127.0.0.1
QUANTABOT_PORT=8000

# 全 fake 开关：true=外部依赖全走内存假实现（M0/M1 默认）；M2 起逐项替换
QUANTABOT_FAKE_MODE=true

# 决策日志 SQLite 路径（默认 data/decisions.db）
QUANTABOT_AUDIT_DB_PATH=data/decisions.db

# ---- M2 真依赖（空值=该项未配置/降级，技术选型「空值即关闭」）----

# Redis（幂等/控制面/成本键；本地 compose：redis://agent-redis:6379/0（容器网络）或 redis://127.0.0.1:6379/0（宿主机））
QUANTABOT_REDIS_URL=

# DeepSeek（OpenAI 兼容端点；key 只进 .env，禁止入库）
QUANTABOT_DEEPSEEK_BASE_URL=https://api.deepseek.com
QUANTABOT_DEEPSEEK_API_KEY=
QUANTABOT_DEEPSEEK_MODEL=deepseek-chat

# Langfuse 自托管（本地 compose 宿主机访问：http://127.0.0.1:3000）
QUANTABOT_LANGFUSE_HOST=http://127.0.0.1:3000
QUANTABOT_LANGFUSE_PUBLIC_KEY=
QUANTABOT_LANGFUSE_SECRET_KEY=

# Qdrant（M3 记忆层用；M2 仅健康检查）
QUANTABOT_QDRANT_URL=http://127.0.0.1:6333

# [Phase 0 已对齐 C-1] RabbitMQ（Tranche B 真接；本地 compose：amqp://quantabot:quantabot-dev@127.0.0.1:5673/——宿主 5673 避开本机 vmnat 占用的 5672）
QUANTABOT_MQ_URL=

# [Phase 0 已对齐 C-2/C-5] 主服务同步接口（评论树/检索/审核/写库；Tranche B 真接）
QUANTABOT_MAIN_SERVICE_BASE_URL=
# [Phase 0 已对齐 C-5] 主服务 service token（demo0 签发长期 JWT；key 只进 .env）
QUANTABOT_MAIN_SERVICE_TOKEN=
# [Phase 0 已对齐 C-5] bot 系统账号 user_id（demo0 seed 后回填）
QUANTABOT_MAIN_SERVICE_BOT_USER_ID=0

# ---- 超时档（分设；熔断三态 M5）----
QUANTABOT_LLM_TIMEOUT_SECONDS=60
QUANTABOT_MAIN_SERVICE_TIMEOUT_SECONDS=10
QUANTABOT_REDIS_TIMEOUT_SECONDS=2
QUANTABOT_LANGFUSE_TIMEOUT_SECONDS=5

# ---- 控制面与成本（G5/G6）----
QUANTABOT_CONTROL_PLANE_POLL_SECONDS=5
QUANTABOT_COST_KEY_TTL_HOURS=48
QUANTABOT_LLM_INPUT_PRICE_PER_MTOK=12
QUANTABOT_LLM_OUTPUT_PRICE_PER_MTOK=24

# ---- M3 记忆/RAG（Tranche 2 真接；embedding 留空 = fake/降级）----

# Qdrant collection（用户记忆 / RAG 内容；M2 仅健康检查，M3 起承载记忆与内容索引）
QUANTABOT_QDRANT_MEMORY_COLLECTION=qb_memory
QUANTABOT_QDRANT_CONTENT_COLLECTION=qb_content

# Qwen embedding（OpenAI 兼容端点；与主服务同源 1024 维——
# 留空 = 用 HashEmbeddingClient fake；base_url/model 与 demo0 application.yml 对齐后才算配置完成）
QUANTABOT_EMBEDDING_BASE_URL=
QUANTABOT_EMBEDDING_API_KEY=
QUANTABOT_EMBEDDING_MODEL=
QUANTABOT_EMBEDDING_DIM=1024

# 记忆召回参数（粗召回 top-k 与精选上限——精选 ≤3 是蓝图钉死的值）
QUANTABOT_MEMORY_RECALL_TOP_K=8
QUANTABOT_MEMORY_SELECT_MAX=3

# 对话级记忆 TTL（小时）——短期状态存储过期即焚
QUANTABOT_DIALOGUE_MEMORY_TTL_HOURS=48

# 远区摘要缓存 TTL（小时）——同帖第二条 @ 复用
QUANTABOT_SUMMARY_CACHE_TTL_HOURS=24

# RAG 检索片段数上限（计入 RESERVED_BUDGET 预留预算）
QUANTABOT_RAG_FRAGMENT_LIMIT=3
