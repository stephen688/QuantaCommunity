.mine {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(
    180deg,
    var(--color-accent-warm-light, #fdf6ec) 0%,
    var(--color-bg, #f7f5f0) 220rpx
  );
}

.mine__header {
  padding: 16rpx 24rpx 0;
}

.mine__completeness {
  margin: 16rpx 24rpx 0;
  padding: 22rpx 24rpx;
  background-color: var(--color-card-bg, #ffffff);
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border, rgba(26, 29, 33, 0.08));
  box-sizing: border-box;
}


.mine__completeness-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.mine__completeness-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1a1d21);
}

.mine__completeness-action {
  font-size: 26rpx;
  color: var(--color-link, #5c6b62);
  flex-shrink: 0;
}

.mine__completeness-track {
  height: 14rpx;
  border-radius: 999rpx;
  background-color: #f0ede7;
  overflow: hidden;
}

.mine__completeness-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(
    90deg,
    var(--color-accent-warm-light, #fdf6ec) 0%,
    var(--color-accent-warm, #b45309) 100%
  );
  transition: width 500ms cubic-bezier(0.16, 1, 0.3, 1);
}

.mine__completeness-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  gap: 12rpx;
}

.mine__completeness-hint {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary, #8c939e);
  line-height: 1.45;
}

.mine__completeness-pct {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #5c6370);
}

.mine__section {
  padding: 8rpx 24rpx 0;
}

.mine__section--list {
  padding-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mine__section-title {
  padding: 8rpx 4rpx 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary, #5c6370);
}

.mine__safe-bottom {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
