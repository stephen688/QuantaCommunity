@import '../../styles/detail-page-shared.wxss';

.detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

.detail-page__pad,
.detail-page__state,
.detail-page__skel {
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-page__pad-inner {
  padding: 0;
}

.detail-page__body {
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-page__card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-page__subhead {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.detail-page__tags {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.detail-page__more {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  padding: 6rpx 8rpx;
  margin-top: 2rpx;
}

.detail-page__imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-page__img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background-color: #f0ede7;
}

.detail-page__hint {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.detail-page__answers {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-page__ans {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-page__ans--accepted {
  border: 2rpx solid rgba(42, 107, 71, 0.2);
  border-radius: 16rpx;
  padding: 20rpx;
  background: rgba(42, 107, 71, 0.03);
}

.detail-page__ans-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.detail-page__ans-head--row {
  align-items: flex-start;
}

.detail-page__ans-author {
  flex: 1;
  min-width: 0;
}

.detail-page__ans-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.detail-page__ans-batch {
  font-size: var(--font-caption, 24rpx);
  color: var(--color-text-tertiary);
}

.detail-page__ans-body-wrap {
  display: block;
  overflow: hidden;
}

.detail-page__ans-body {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
  word-break: break-word;
  line-height: 1.65;
  font-size: var(--font-body, 28rpx);
  max-height: calc(28rpx * 1.65 * 5);
}

.detail-page__ans-foot {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.detail-page__ans-foot-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.detail-page__ans-time,
.detail-page__ans-stat {
  font-size: var(--font-caption, 24rpx);
  color: var(--color-text-tertiary);
}

.detail-page__ans-stat--tap {
  color: var(--color-link, #5c6b62);
}

.detail-page__ans-stat--hover {
  opacity: 0.72;
}

.detail-page__ans-like {
  font-size: var(--font-caption, 24rpx);
  color: var(--color-text-secondary);
  padding: 4rpx 0;
}

.detail-page__ans-like--on {
  color: var(--color-brand);
  font-weight: 500;
  animation: icon-pulse var(--duration-slow, 300ms) cubic-bezier(0.16, 1, 0.3, 1);
}

.detail-page__ans-more {
  font-size: var(--font-caption, 24rpx);
  color: var(--color-text-secondary);
  padding: 4rpx 0;
}

.detail-page__ans-entry {
  margin-top: 4rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-divider);
}

.detail-page__ans-entry-text {
  font-size: var(--font-caption, 24rpx);
  color: var(--color-link, #5c6b62);
}

.detail-page__fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 40;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--color-cta, #1e5a4c);
  box-shadow: var(--shadow-fab, 0 10rpx 24rpx rgba(30, 90, 76, 0.22));
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-page__fab--hover {
  opacity: 0.85;
}

.detail-page__fab-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

/* 底栏 + 发布回答 FAB，避免最后一条回答被遮挡 */
.detail-page__foot-spacer {
  height: calc(224rpx + env(safe-area-inset-bottom));
}

.detail-page__more--hover {
  opacity: 0.72;
}

.detail-page__ans-like--hover {
  opacity: 0.85;
}
