.mc {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
  background-color: var(--color-bg, #f7f5f0);
}

.mc__tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: none;
}

.mc__chip {
  padding: 10rpx 20rpx;
  border-radius: var(--radius-chip, 999rpx);
  font-size: 24rpx;
  color: var(--color-chip-neutral-text, #5c6370);
  background: var(--color-chip-neutral-bg, #f0ede7);
  border: 1rpx solid var(--color-border, rgba(26, 29, 33, 0.08));
  box-sizing: border-box;
}

.mc__chip--on {
  color: var(--color-brand, #1e5a4c);
  background: var(--color-brand-light, #e8f2ef);
  border-color: rgba(30, 90, 76, 0.18);
}

.mc__chip--rejected.mc__chip--on {
  color: var(--color-danger, #c43d3d);
  background: rgba(196, 61, 61, 0.08);
  border-color: rgba(196, 61, 61, 0.2);
}

.mc__chip--approved.mc__chip--on {
  color: var(--color-success, #2a6b47);
  background: rgba(42, 107, 71, 0.12);
  border-color: rgba(42, 107, 71, 0.2);
}

.mc__chip--hover {
  opacity: 0.85;
}

.mc__state {
  padding: 48rpx 0;
}

.mc__cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mc__safe-bottom {
  height: var(--space-tabbar-safe);
}
