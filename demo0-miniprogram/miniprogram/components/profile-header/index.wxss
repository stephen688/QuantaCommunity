.ph {
  padding: 28rpx 24rpx 24rpx;
}

.ph__top {
  margin-bottom: 4rpx;
}

.ph__skel {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
}

.ph__skel-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.ph__skel-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ph__skel-line {
  height: 32rpx;
  border-radius: 10rpx;
  width: 60%;
}

.ph__skel-line--short {
  width: 40%;
  height: 26rpx;
}

.skel-line {
  background: linear-gradient(90deg, #e8e3da 0%, #f7f5f0 50%, #e8e3da 100%);
  background-size: 200% 100%;
  animation: ph-pulse 1.1s ease-in-out infinite;
}

@keyframes ph-pulse {
  0% {
    background-position: 0% 0%;
  }
  100% {
    background-position: -200% 0%;
  }
}

.ph__err {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.ph__err-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
}

.ph__err-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary, #646a73);
  line-height: 1.45;
}

.ph__err-btn {
  margin-top: 8rpx;
  border-radius: 28rpx;
  color: var(--color-link, #5c6b62);
  border: 1rpx solid var(--color-border, rgba(26, 29, 33, 0.12));
}

.ph__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 22rpx;
}

.ph__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #f0ede7;
  border: 2rpx solid var(--color-brand-muted, rgba(30, 90, 76, 0.12));
  box-sizing: border-box;
}

.ph__avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #f4f1ea, var(--color-chip-neutral-bg, #f0ede7));
  border-color: var(--color-border, rgba(26, 29, 33, 0.08));
}

.ph__avatar-letter {
  font-size: 44rpx;
  color: var(--color-text-secondary, #646a73);
  font-weight: 600;
}

.ph__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ph__name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.ph__name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ph__edit {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border, rgba(26, 29, 33, 0.08));
  background-color: var(--color-card-bg, #ffffff);
}

.ph__edit--hover {
  opacity: 0.9;
}

.ph__edit-text {
  font-size: 24rpx;
  color: var(--color-text-secondary, #646a73);
}

.ph__badge-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.ph__badge {
  font-size: 22rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.ph__badge--success {
  color: var(--color-success, #2a6b47);
  background-color: rgba(42, 107, 71, 0.12);
}

.ph__badge--warning {
  color: var(--color-warning, #b45309);
  background-color: rgba(180, 83, 9, 0.12);
}

.ph__badge--danger {
  color: var(--color-danger, #c43d3d);
  background-color: rgba(196, 61, 61, 0.1);
}

.ph__badge--neutral {
  color: var(--color-text-secondary, #5c6370);
  background-color: rgba(26, 29, 33, 0.06);
}

.ph__id-type {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #8f959e);
}

.ph__identity {
  margin-top: -4rpx;
}

.ph__identity-text {
  font-size: 24rpx;
  color: var(--color-text-secondary, #646a73);
  line-height: 1.45;
  word-break: break-all;
}

.ph__stats {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 20rpx 8rpx;
  border-radius: 12rpx;
  background: linear-gradient(
    180deg,
    var(--color-chip-neutral-bg, #f0ede7) 0%,
    rgba(247, 245, 240, 0.65) 100%
  );
  border: 1rpx solid var(--color-border, rgba(26, 29, 33, 0.08));
  box-sizing: border-box;
}

.ph__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
}

.ph__stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary, #1f2329);
  font-feature-settings: "tnum";
}

.ph__stat-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #8f959e);
}

.ph__stat-div {
  width: 1rpx;
  align-self: stretch;
  margin: 8rpx 0;
  background-color: var(--color-divider, rgba(26, 29, 33, 0.06));
}

.ph__bio {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary, #646a73);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
