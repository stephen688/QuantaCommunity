.plf {
  padding: 8rpx 24rpx;
  box-sizing: border-box;
}

.plf__row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.plf__row--action {
  padding: 8rpx 16rpx;
}

.plf__row--hover {
  opacity: 0.85;
}

.plf__text {
  text-align: center;
  font-size: 26rpx;
  line-height: 1.4;
}

.plf__text--muted {
  color: var(--color-text-tertiary, #6b7280);
}

.plf__text--action {
  color: var(--color-link, #5c6b62);
}

.plf__dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-right: 12rpx;
}

.plf__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--color-text-tertiary, #6b7280);
  animation: plf-dot-bounce 1.2s ease-in-out infinite;
}

.plf__dot:nth-child(2) {
  animation-delay: 0.15s;
}

.plf__dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes plf-dot-bounce {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.75);
  }
  40% {
    opacity: 1;
    transform: scale(1);
  }
}
