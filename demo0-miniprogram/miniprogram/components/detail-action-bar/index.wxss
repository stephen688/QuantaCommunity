.dab {
  padding: 0;
  box-sizing: border-box;
}

.dab--fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 0 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: var(--color-surface-elevated, #fff);
  border-top: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.dab__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
}

.dab__composer-trigger {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-chip, 999rpx);
  background-color: var(--color-chip-neutral-bg, #f0ede7);
  box-sizing: border-box;
}

.dab__composer-trigger--hover,
.dab__action--hover {
  opacity: 0.75;
  transform: scale(0.96);
  transition: all var(--duration-fast, 150ms) var(--ease-standard, ease);
}

.dab__composer-placeholder {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--color-text-tertiary, #8c939e);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dab__actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.dab__action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 88rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.dab__icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.dab__icon-img {
  display: block;
  transition: opacity 0.2s ease;
}

.dab__count {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-stat, #646a73);
  line-height: 1.2;
}

.dab__count--comment {
  color: var(--color-stat, #646a73);
}

.dab__action--liked .dab__icon {
  animation: icon-pulse var(--duration-slow, 300ms) cubic-bezier(0.16, 1, 0.3, 1);
}

.dab__action--liked .dab__count {
  color: var(--color-like-active, #ef4444);
}

.dab__action--collected .dab__icon {
  animation: icon-pulse var(--duration-slow, 300ms) cubic-bezier(0.16, 1, 0.3, 1);
}

.dab__action--collected .dab__count {
  color: var(--color-favorite-active, #f59e0b);
}
