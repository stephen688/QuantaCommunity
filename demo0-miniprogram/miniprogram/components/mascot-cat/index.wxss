.mascot-cat {
  position: absolute;
  z-index: 4;
  pointer-events: none;
  opacity: 0.85;
  animation: mascotFloat 3.6s ease-in-out infinite alternate;
}

.mascot-cat--left {
  left: -16rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.mascot-cat--right {
  right: -8rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  transform: scaleX(-1);
  animation-name: mascotFloatMirrored;
}

.mascot-cat__img {
  width: 200rpx;
  height: 200rpx;
  display: block;
}

/* CSS 降级小猫 */
.mascot-cat__css {
  position: relative;
  width: 160rpx;
  height: 180rpx;
}

.mascot-cat__css-head {
  position: absolute;
  top: 0;
  left: 50%;
  width: 100rpx;
  height: 90rpx;
  margin-left: -50rpx;
  border-radius: 50%;
  background: #fffaf2;
  box-shadow: inset 0 -4rpx 8rpx rgba(61, 42, 31, 0.06);
}

.mascot-cat__css-ear {
  position: absolute;
  top: 4rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 32rpx solid #fffaf2;
}

.mascot-cat__css-ear--l {
  left: 18rpx;
  transform: rotate(-12deg);
}

.mascot-cat__css-ear--r {
  right: 18rpx;
  transform: rotate(12deg);
}

.mascot-cat__css-eye {
  position: absolute;
  top: 36rpx;
  width: 12rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #3d2a1f;
}

.mascot-cat__css-eye--l {
  left: 24rpx;
}

.mascot-cat__css-eye--r {
  right: 24rpx;
}

.mascot-cat__css-nose {
  position: absolute;
  top: 54rpx;
  left: 50%;
  width: 10rpx;
  height: 8rpx;
  margin-left: -5rpx;
  border-radius: 50% 50% 40% 40%;
  background: #ffb8a8;
}

.mascot-cat__css-body {
  position: absolute;
  top: 72rpx;
  left: 50%;
  width: 88rpx;
  height: 72rpx;
  margin-left: -44rpx;
  border-radius: 50%;
  background: #fffaf2;
}

.mascot-cat__css-bell {
  position: absolute;
  top: 18rpx;
  left: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #fe6603, #ff8c42);
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.35);
}

.mascot-cat__css-tail {
  position: absolute;
  top: 100rpx;
  right: 8rpx;
  width: 48rpx;
  height: 20rpx;
  border-radius: 20rpx;
  background: #fffaf2;
  transform: rotate(-28deg);
}

@keyframes mascotFloat {
  0% {
    transform: translateY(0);
  }
  100% {
    transform: translateY(-14rpx);
  }
}

@keyframes mascotFloatMirrored {
  0% {
    transform: scaleX(-1) translateY(0);
  }
  100% {
    transform: scaleX(-1) translateY(-14rpx);
  }
}

@media (prefers-reduced-motion: reduce) {
  .mascot-cat {
    animation: none;
  }

  .mascot-cat--right {
    transform: scaleX(-1);
  }
}

.mascot-cat.motion-reduced {
  animation: none;
}

.mascot-cat.motion-reduced.mascot-cat--right {
  transform: scaleX(-1);
}
