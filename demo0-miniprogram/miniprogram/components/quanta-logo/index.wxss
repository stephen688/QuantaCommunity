.quanta-logo {
  display: flex;
  justify-content: center;
  align-items: center;
}

.quanta-logo__frame {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border-radius: 52rpx;
  overflow: hidden;
  background: linear-gradient(155deg, #1c1c20 0%, #141418 36%, #0d0d10 68%, #111114 100%);
  box-shadow:
    0 6rpx 16rpx rgba(0, 0, 0, 0.22),
    0 24rpx 48rpx rgba(61, 42, 31, 0.18),
    0 0 0 1rpx rgba(255, 255, 255, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1),
    inset 0 0 48rpx rgba(254, 102, 3, 0.06);
}

.quanta-logo__shine {
  position: absolute;
  top: 0;
  left: 6%;
  right: 6%;
  height: 42%;
  border-radius: 52rpx 52rpx 62% 62%;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.14) 0%,
    rgba(255, 255, 255, 0.04) 42%,
    transparent 100%
  );
  pointer-events: none;
  z-index: 2;
}

.quanta-logo__img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.04);
  transform-origin: center center;
}

.quanta-logo--sm .quanta-logo__frame {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
}

.quanta-logo--sm .quanta-logo__shine {
  border-radius: 40rpx 40rpx 60% 60%;
}

.quanta-logo--xs .quanta-logo__frame {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
}

.quanta-logo--xs .quanta-logo__shine {
  border-radius: 14rpx 14rpx 58% 58%;
}
