/* 登录页同系暖色授权弹窗 — 紧凑资料行 */

.login-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.login-sheet--in {
  pointer-events: auto;
}

.login-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(61, 42, 31, 0.35);
  opacity: 0;
  transition: opacity 240ms ease;
}

.login-sheet--in .login-sheet__mask {
  opacity: 1;
}

.login-sheet__dialog {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 620rpx;
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.98) 0%, rgba(255, 248, 237, 0.96) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(61, 42, 31, 0.12);
  box-sizing: border-box;
  overflow: hidden;
  transform: scale(0.94);
  opacity: 0;
  transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease;
}

.login-sheet--in .login-sheet__dialog {
  transform: scale(1);
  opacity: 1;
}

.login-sheet__body {
  padding: 28rpx 32rpx 0;
}

.login-sheet__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.login-sheet__app-name {
  font-size: 26rpx;
  color: #8a6b55;
  line-height: 1.2;
}

.login-sheet__heading {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #3d2a1f;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.login-sheet__hint {
  display: block;
  font-size: 22rpx;
  color: #8a6b55;
  line-height: 1.4;
  margin-bottom: 18rpx;
}

.login-sheet__profile {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin: 0 -32rpx;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid rgba(138, 107, 85, 0.12);
  border-bottom: 1rpx solid rgba(138, 107, 85, 0.12);
}

.login-sheet__profile--ready {
  padding-right: 72rpx;
}

.login-sheet__profile--error {
  background: rgba(254, 102, 3, 0.05);
}

/* button 默认会撑满 flex，必须锁死宽高 */
.login-sheet__avatar-btn {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  overflow: visible;
}

.login-sheet__avatar-btn::after {
  border: none;
}

.login-sheet__avatar-btn--hover {
  opacity: 0.88;
}

.login-sheet__profile-avatar {
  display: block;
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(138, 107, 85, 0.1);
}

.login-sheet__profile-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-sheet__avatar-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(138, 107, 85, 0.28);
}

.login-sheet__profile-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.login-sheet__profile-name {
  display: block;
  width: 100%;
  font-size: 28rpx;
  font-weight: 500;
  color: #3d2a1f;
  line-height: 1.35;
  min-height: 38rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.login-sheet__profile-name--error {
  color: #c44a00;
}

.login-sheet__profile-desc {
  font-size: 22rpx;
  color: #8a6b55;
  line-height: 1.2;
}

.login-sheet__profile-check {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  flex-shrink: 0;
}

.login-sheet__check-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #fe6603;
  position: relative;
}

.login-sheet__check-icon::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 5rpx;
  width: 6rpx;
  height: 11rpx;
  border: solid #ffffff;
  border-width: 0 2rpx 2rpx 0;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.login-sheet__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 32rpx 30rpx;
  box-sizing: border-box;
}

.login-sheet__btn {
  flex: 1;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.login-sheet__btn::after {
  border: none;
}

.login-sheet__btn--refuse {
  color: #8a6b55;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(138, 107, 85, 0.18);
}

.login-sheet__btn--refuse-hover {
  background: rgba(255, 255, 255, 0.92);
}

.login-sheet__btn--allow {
  color: #ffffff;
  background: linear-gradient(135deg, #fe6603 0%, #ff8c42 100%);
  box-shadow: 0 12rpx 28rpx rgba(254, 102, 3, 0.18);
}

.login-sheet__btn--allow-hover {
  opacity: 0.92;
}

.login-sheet__btn[disabled] {
  opacity: 0.6;
}

@media (prefers-reduced-motion: reduce) {
  .login-sheet__mask,
  .login-sheet__dialog {
    transition-duration: 0.01ms !important;
  }
}

.login-sheet.motion-reduced .login-sheet__mask,
.login-sheet.motion-reduced .login-sheet__dialog {
  transition-duration: 0.01ms !important;
}
