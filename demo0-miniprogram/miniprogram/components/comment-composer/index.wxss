.cc {
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.cc__input {
  width: 100%;
  min-height: 120rpx;
  max-height: 320rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--color-text-primary, #1f2329);
  box-sizing: border-box;
}

.cc__footer {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.cc__tools {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.cc__mention {
  flex-shrink: 0;
  margin: 0;
  padding: 0 16rpx;
  height: 52rpx;
  line-height: 50rpx;
  border: 1rpx solid rgba(30, 90, 76, 0.28);
  border-radius: 26rpx;
  color: var(--color-cta, #1e5a4c);
  background-color: rgba(30, 90, 76, 0.08);
  font-size: 24rpx;
  box-sizing: border-box;
}

.cc__mention::after {
  border: 0;
}

.cc__mention--hover {
  opacity: 0.82;
  background-color: rgba(30, 90, 76, 0.14);
}

.cc__hint {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary, #8f959e);
}

.cc__btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  background-color: var(--color-cta, #1e5a4c) !important;
}

.cc__btn--hover {
  opacity: 0.9;
}
